{
  "name": "sim-league",
  "version": "0.1.0",
  "private": true,
  "description": "Always-on fictional sports league (Scorchball) simulated 24/7 and presented as a pixel-art channel.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\"",
    "ff": "node src/cli/ff.js",
    "balance": "node src/cli/balance.js",
    "channel": "node src/cli/serve.js",
    "parity": "node src/cli/parity.js",
    "director": "node src/cli/director.js",
    "facts": "node src/cli/facts.js",
    "talk": "node src/cli/talkCount.js",
    "pitchmap": "node src/cli/pitchmap.js",
    "rundown": "node src/cli/rundown.js",
    "voices": "node src/cli/voices.js",
    "repeats": "node src/cli/repeats.js",
    "moments": "node src/cli/moments.js",
    "coins": "node src/cli/coins.js",
    "publish": "node src/cli/publish.js",
    "daykey": "node src/cli/daykey.js",
    "livecheck": "node src/cli/liveCheck.js",
    "worker": "npx --yes wrangler@4.149.0 deploy --config worker/wrangler.jsonc",
    "icon": "node src/cli/icon.js --write",
    "clip": "node src/cli/clip.js",
    "public": "node src/cli/publicCopy.js"
  },
  "devDependencies": {
    "ffmpeg-static": "^5.3.0",
    "kokoro-js": "^1.2.1"
  }
}
